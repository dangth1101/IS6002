# Copy to .env and fill in. .env is gitignored.

# Any OpenAI-compatible endpoint. OpenRouter by default.
# Local Ollama instead: http://localhost:11434/v1 (any non-empty LLM_API_KEY works)
LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter key from https://openrouter.ai/settings/keys
LLM_API_KEY=

# Model the Streamlit app uses, as OpenRouter's vendor/model id.
# The batch script defaults to this too; override with --model (repeatable),
# e.g. --model openai/gpt-3.5-turbo --model openai/gpt-4.1
LLM_MODEL=openai/gpt-4.1
